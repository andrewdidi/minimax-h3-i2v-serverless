# MiniMax H3 I2V · RunPod 环境变量
#
# ========== A. 临时 Pod 填盘（只跑一次）==========
# Docker Start Command:
#   bash /comfyui/pod_fill_volume.sh
# VOLUME_ROOT=/runpod-volume
# HF_TOKEN=hf_xxx
#
# ========== B. Serverless 日常（模型已在 Volume）==========
VOLUME_ROOT=/runpod-volume
DOWNLOAD_MODELS_ON_START=0
REQUIRE_MODELS=1
#
# 禁止日常: DOWNLOAD_MODELS_ON_START=1
# 禁止生产: ALLOW_MISSING_MODELS=1
